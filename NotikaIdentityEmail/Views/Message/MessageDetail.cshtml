@model MessageWithSenderInfoViewModel
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="inbox-area">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("_MessageSidebarComponentPartial")
            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                <div class="view-mail-list sm-res-mg-t-30">
                    <div class="view-mail-hd">
                        <div class="view-mail-hrd">
                            <h2>Email view</h2>
                        </div>
                        <div class="view-ml-rl">
                            @{
                                var timeDifference = DateTime.Now - Model.SendDate;

                                var days = (int)timeDifference.TotalDays;
                                var hours = timeDifference.Hours;
                            }

                            <p>
                                @if (days > 0)
                                {
                                    @($"{days} days {hours} hours ago")
                                }
                                else if (hours > 0)
                                {
                                    @($"{hours} hours ago")
                                }
                                else if (timeDifference.Minutes > 0)
                                {
                                    @($"{timeDifference.Minutes} minutes ago")
                                }
                                else
                                {
                                    @("Just now")
                                }
                            </p>
                        </div>
                    </div>
                    <div class="mail-ads mail-vw-ph">
                        <p class="first-ph"><b>Subject: </b>@Model.Subject</p>
                        <p class="first-ph"><b>Category: </b>@Model.CategoryName</p>
                        <p class="first-ph"><b>Sender: </b>@Model.SenderName @Model.SenderSurname</p>
                        <p><b>Email:</b> <a href="#">@Model.SenderEmail</a></p>
                        <p class="last-ph"><b>Date:</b> @Model.SendDate.ToString("dd MMMM yyyy") - @Model.SendDate.ToString("HH:MM")</p>
                    </div>
                    <div class="view-mail-atn">
                        <p>@Html.Raw(@Model.MessageDetail)</p>
                    </div>
                    <div class="vw-ml-action-ls text-right mg-t-20">
                        <div class="btn-group ib-btn-gp active-hook nk-email-inbox">
                            <button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-next"></i> Reply</button>
                            <button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-right-arrow"></i> Forward</button>
                            <button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-print"></i> Print</button>
                            <button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-trash"></i> Remove</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>