@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-Mail Validation - Notika</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/register.css" rel="stylesheet" />

    <style>
        .code-input {
            text-align: center;
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: .6rem;
            padding-left: 1.2rem;
        }

        .code-hint {
            color: #6c757d;
            font-size: .9rem;
            text-align: center;
            margin-bottom: 1.25rem;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="register-header">
            <div class="logo"><i class="bi bi-envelope-paper-heart"></i></div>
            <h1>E-Mail Validation</h1>
        </div>

        <div class="register-body">
            <form asp-controller="Activation" asp-action="UserActivation" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <p class="code-hint">Enter the 6-digit verification code we sent to your e-mail address.</p>

                <div class="row g-3">
                    <div class="col-12">
                        <label for="codeInput" class="form-label">Verification Code</label>
                        <input type="text"
                               name="userCodeParameter"
                               id="codeInput"
                               class="form-control code-input"
                               placeholder="------"
                               maxlength="6"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               autocomplete="one-time-code"
                               autofocus
                               required />
                    </div>
                </div>

                <button type="submit" class="btn btn-register w-100 mt-4">
                    <i class="bi bi-shield-check me-1"></i> Verify
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Allow digits only
        document.getElementById('codeInput').addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '');
        });
    </script>
</body>
</html>